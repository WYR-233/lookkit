{
  "id": "example-catalog",
  "name": "商品图标注（示例）",
  "version": 1,
  "note": "中性示例档案。演示 annotate + audit 两种模式，任何内容都不指向真实业务。",

  "sheet": {
    "mode": "tiles",
    "tile": 240,
    "cols": 6,
    "per": 24,
    "background": "#222222",
    "label": "{n}",
    "_locked": "示例值，可随意改。改完记得让 prompt 的描述跟着改。"
  },

  "id_pattern": "{group}/{stem}",

  "fields": [
    { "key": "category", "type": "enum", "fallback": "其他",
      "values": ["服装", "鞋包", "数码", "家居", "食品", "其他"] },
    { "key": "color",     "type": "string", "max": 20 },
    { "key": "condition", "type": "enum", "fallback": "未知",
      "values": ["全新", "轻微使用痕迹", "明显磨损", "破损", "未知"] },
    { "key": "defects",   "type": "list", "max": 5, "item_max": 12 },
    { "key": "desc",      "type": "string", "max": 120 },
    { "key": "en",        "type": "string", "max": 40 }
  ],

  "review": {
    "title": "商品图标注审核",
    "display": ["category", "color", "condition", "defects", "desc", "en"],
    "thumbnail": "raw",
    "checks": [
      {
        "key": "shot_ok",
        "label": "成片",
        "note": "shot_note",
        "derived": {
          "when": "note =~ /裁|太暗|反光|模糊|挡住/",
          "then": "reject_shot",
          "label": "构图/曝光问题"
        }
      }
    ]
  },

  "rules": [
    { "when": "condition == '破损'", "min_list": { "defects": 1 } }
  ],

  "prompts": {
    "annotate": "prompt.annotate.md",
    "audit": "prompt.audit.md"
  },

  "audit": {
    "input": "work/annot/merged.jsonl",
    "output": "work/annot/audit.jsonl",
    "report": "work/annot/audit-report.md",
    "only_changed": true,
    "workdir": null
  },

  "targets": ["catalog-json"]
}
